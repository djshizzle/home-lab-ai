{
  "permissions": {
    "allow": [
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(ls *)",
      "Bash(find * -not -name '*.env')",
      "Bash(python scripts/generate_server_wrappers.py *)",
      "Read(*)",
      "mcp__code-execution__run_python"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo rm *)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(curl * | sh)",
      "Bash(chmod 777 *)"
    ]
  },
  "enableAllProjectMcpServers": true
}
