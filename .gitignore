# Agent workspace — keep directory structure, but ignore generated session files
# (research findings, plans, reviews are session-specific; commit selectively)
.claude/workspace/research/*.md
.claude/workspace/plans/*.md
.claude/workspace/reviews/*.md
.claude/workspace/docs-drafts/*.md
.claude/workspace/pr-description.md

# Keep the directory structure and state template
!.claude/workspace/AGENT_STATE.md
!.claude/workspace/**/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
dist/
*.egg-info/
.pytest_cache/

# Never commit secrets
.env
.env.*
*.pem
*.key
secrets.*
credentials.*
service-account*.json

# Agent team hand-off workspace (session-specific, not committed)
.agent-workspace/
